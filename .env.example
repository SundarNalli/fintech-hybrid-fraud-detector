# Copy to .env (git-ignored) and fill in only if you want live mode.
# With no key set, the agent runs in replay mode on recorded responses.

OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Spend caps, in US dollars. Defaults live in config/thresholds.toml.
MAX_USD_PER_CASE=
MAX_USD_PER_EVAL_RUN=
MAX_OUTPUT_TOKENS=
