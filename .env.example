# Copy to .env (git-ignored) and fill in only if you want live mode.
# With no key set, the agent runs in replay mode on recorded responses.

OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Prices in US dollars per million tokens, so the budget meter can report cost per case.
# Look up your model's current prices yourself; none are hard-coded here. Empty means cost shows as 0.
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=

# Spend caps, in US dollars. Defaults live in config/thresholds.toml.
MAX_USD_PER_CASE=
MAX_USD_PER_EVAL_RUN=
MAX_OUTPUT_TOKENS=
